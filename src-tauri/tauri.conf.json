{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeatherDesk",
  "version": "3.0.3",
  "identifier": "io.github.davidmay87.weatherdesk",
  "build": {
    "frontendDist": "../site"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "msi",
      "nsis",
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "Tempest weather dashboard",
    "longDescription": "Self-hosted dashboard for a WeatherFlow Tempest station. Also serves the dashboard on your LAN so a wall tablet can display it.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5MTQyNUJGNzgwRjU3NkMKUldSc1Z3OTR2eVVVcVRCRTFWcXovdXdmUXBaNllNMCtId05zQjcxMEo3a2labkRXR2dFdy9Zb0cK",
      "endpoints": [
        "https://github.com/d4vid87/weatherdesk/releases/latest/download/latest.json"
      ]
    }
  }
